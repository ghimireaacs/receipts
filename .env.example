# ---- Required ----
# Paperless-ngx: URL as seen from this container, and an API token (Paperless: My Profile -> API Auth Token)
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=changeme
# Ollama, with a vision model pulled (ollama pull gemma3:4b)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# Host folders. DB_DIR: the SQLite ledger, on a local disk. PHOTO_STORE: photos and a daily ledger copy.
DB_DIR=./data/db
PHOTO_STORE=./data/store

# ---- The phone app ----
# Where the app listens on the host. 127.0.0.1 = only through a reverse proxy on the same machine.
APP_BIND=127.0.0.1
APP_PORT=8098
# A shared passcode the phone asks for once. Leave empty when a proxy does the sign-in (see AUTH_PEOPLE).
APP_PASSCODE=changeme
# The people who spend: Name, or Name:paperless-owner-tag-id:immich-user-id. Comma separated.
PEOPLE=Alex,Sam
# Currency: ISO code used for Paperless amounts
CURRENCY=AUD
TZ=Australia/Sydney

# ---- Optional: sign-in through a reverse proxy (Authentik, Authelia, oauth2-proxy, ...) ----
# Proxy username -> person, and the proxy's IP (the username header is trusted only from there)
AUTH_PEOPLE=
PROXY_IPS=
# With AUTH_PEOPLE set, everyone adds and sees only their own entries; these people may do it for anyone
ADMINS=

# ---- Optional: Immich album as a second way in ----
IMMICH_URL=
IMMICH_API_KEY=
ALBUM_NAME=Paperless
POLL_SECONDS=120

# ---- Optional: Wallos bill reminders ----
WALLOS_URL=
WALLOS_API_KEY=
WALLOS_NOTIFY_DAYS=3
# The currency's id in your Wallos (Settings -> Currencies)
WALLOS_CURRENCY_ID=1
