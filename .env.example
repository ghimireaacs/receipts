# Receipts settings. Copy to .env and fill in what applies to you.
# Each service below is either one you already run (put its address) or one compose.yml
# can start for you (turn its profile on, see compose.yml). Addresses are as seen from
# inside the container: use the machine's LAN address, not localhost.

# ============ The model (required) ============
# Already run Ollama?           OLLAMA_URL=http://192.0.2.20:11434
# Let compose run it?           docker compose --profile ollama up -d, then OLLAMA_URL=http://ollama:11434
# Then pull a vision model:     ollama pull gemma3:4b
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# ============ Paperless-ngx (optional: OCR and the archive) ============
# Leave PAPERLESS_URL empty to run without it: the app keeps the ledger and photos on its own.
# Already run Paperless?        PAPERLESS_URL=http://192.0.2.10:8000 and a token (My Profile -> API Auth Token)
# Let compose run it?           docker compose --profile paperless up -d, then PAPERLESS_URL=http://paperless:8000
#                               and PAPERLESS_USER / PAPERLESS_PASSWORD below (the admin it creates; no token needed)
# Either way, once:             docker compose run --rm receipt-bridge python setup_paperless.py
PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_USER=admin
PAPERLESS_PASSWORD=change-me
# Only used when compose runs Paperless:
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string
PAPERLESS_PORT=8010

# ============ The phone app ============
# Where the app listens. 127.0.0.1 = only through a reverse proxy on this machine; 0.0.0.0 = the whole LAN.
APP_BIND=0.0.0.0
APP_PORT=8098
# A shared passcode the phone asks for once. Leave empty when a sign-in proxy names each person (below).
APP_PASSCODE=change-me
# The people who spend: Name, or Name:paperless-owner-tag-id:immich-user-id. Comma separated.
PEOPLE=Alex,Sam

# Local conventions
CURRENCY=AUD
# How dates are printed on your receipts: DMY, MDY or YMD
DATE_ORDER=DMY
# What receipts call the tax: GST, VAT, Tax ...
TAX_LABEL=GST
TZ=Australia/Sydney
# Without Paperless: your own categories and payment methods, comma separated (empty = the built-in list)
CATEGORIES=
PAYMENT_METHODS=

# Where things are kept (defaults: ./data/...)
DB_DIR=./data/db
PHOTO_STORE=./data/store

# ============ Optional: sign-in per person (Authentik, Authelia, oauth2-proxy ...) ============
# Proxy username -> person, and the proxy's address (the username header is trusted only from there).
# With this set, everyone adds and sees only their own entries; ADMINS may do it for anyone.
AUTH_PEOPLE=
PROXY_IPS=
ADMINS=

# ============ Optional: Immich album as a second way in ============
IMMICH_URL=
IMMICH_API_KEY=
ALBUM_NAME=Paperless
POLL_SECONDS=120

# ============ Optional: Wallos bill reminders ============
WALLOS_URL=
WALLOS_API_KEY=
WALLOS_NOTIFY_DAYS=3
# The currency's id in your Wallos (Settings -> Currencies)
WALLOS_CURRENCY_ID=1
